# Copy to .env and adjust. Never commit .env.
HEINZEL_ENV=dev

# Runtime connection (role heinzel_app, row level security applies)
HEINZEL_DATABASE_URL=postgresql+psycopg://heinzel_app:heinzel_app@localhost:5432/heinzel
# Migrations and CLI (schema owner); `heinzel migrate` creates heinzel_app with this password
HEINZEL_MIGRATION_DATABASE_URL=postgresql+psycopg://heinzel:heinzel@localhost:5432/heinzel
HEINZEL_APP_DB_PASSWORD=heinzel_app

# Encrypts secrets at rest (TOTP seeds). Required outside dev, e.g. `openssl rand -base64 48`.
# Changing it makes existing TOTP enrolments unreadable.
# HEINZEL_SECRET_KEY=

HEINZEL_VALKEY_URL=redis://localhost:6379/0

# Web: where the SvelteKit server reaches the API
API_URL=http://localhost:8000
