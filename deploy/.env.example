# Production settings for compose.prod.yml. Copy to deploy/.env, fill in, never commit it.
# Generate secrets with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Public address(es) of the portal; must also be listed in tenants/<slug>/tenant.json "domains".
HEINZEL_DOMAIN=heinzel.schmelzi.ch
# For Let's Encrypt notices about the certificate.
ACME_EMAIL=it@schmelzi.ch

# Database owner (migrations, export/import) and the runtime role.
POSTGRES_PASSWORD=
HEINZEL_APP_DB_PASSWORD=

# Encrypts secrets at rest (TOTP seeds, SMTP password). Keep it safe: without it 2FA and the
# SMTP password in an export cannot be read. Never change it on a running installation.
HEINZEL_SECRET_KEY=

# Daily exports in ./backups to keep.
BACKUP_KEEP=14
