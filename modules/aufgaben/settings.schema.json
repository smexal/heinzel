{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aufgaben: module settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assign_scope": { "type": "string", "enum": ["list_members", "tenant"], "default": "list_members", "title": "Zuweisen an" },
    "reminder": { "type": "string", "enum": ["inbox", "inbox_and_email", "none"], "default": "inbox", "title": "Erinnerung bei Fälligkeit" },
    "delete_done_after_months": { "type": ["integer", "null"], "enum": [6, 12, 24, null], "default": 24, "title": "Erledigte Aufgaben löschen nach (Monate, null = nie)" },
    "personal_list_name": { "type": "string", "minLength": 1, "maxLength": 60, "default": "Meine Aufgaben", "title": "Name der persönlichen Liste" },
    "shared_lists_enabled": { "type": "boolean", "default": true, "title": "Geteilte Listen erlauben" },
    "quick_action_enabled": { "type": "boolean", "default": true, "title": "Schnellaktion «Aufgabe erfassen»" },
    "widget_enabled": { "type": "boolean", "default": true, "title": "Widget «Heute fällig»" },
    "search_enabled": { "type": "boolean", "default": true, "title": "In der Suche anzeigen" }
  }
}
